<UserControl x:Class="ProductivityManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ProductivityManager.Views.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="1920"
             d:DesignWidth="1080">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#F5F5F5">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">

            <TextBlock Text="{Binding CurrentDateText}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#202020"/>

            <Button Content="Add Task"
                    Command="{Binding AddTaskCommand}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,20,0"
                    Padding="12,6"/>

        </Grid>

        <!-- Seven Days -->
        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding Days}"
                      Margin="15,0,15,15">
            
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- One Day -->
                    <Border Background="White"
                            BorderBrush="#CCCCCC"
                            BorderThickness="1"
                            CornerRadius="5"
                            Margin="3"
                            Padding="8">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Day Name -->
                            <TextBlock Grid.Row="0"
                                       Text="{Binding DayName}"
                                       HorizontalAlignment="Center"
                                       FontSize="18"
                                       FontWeight="SemiBold"/>

                            <!-- Date -->
                            <TextBlock Grid.Row="1"
                                       Text="{Binding DateText}"
                                       HorizontalAlignment="Center"
                                       Foreground="#606060"
                                       Margin="0,2,0,10"/>
                            
                            <!-- Tasks For This Day -->
                            <ItemsControl Grid.Row="2" ItemsSource="{Binding Occurrences}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Command="{Binding DataContext.OpenTaskCommand,
                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Task}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Margin="0,3"
                                                HorizontalContentAlignment="Stretch">

                                            <Border Background="WhiteSmoke"
                                                    BorderBrush="#444444"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8">

                                                <StackPanel>
                                                    <!-- Name -->
                                                    <TextBlock Text="{Binding Task.TaskName}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>

                                                    <!-- Category -->
                                                    <TextBlock Text="{Binding Task.Category}"
                                                               FontSize="11"
                                                               Foreground="#606060"
                                                               Margin="0,2,0,4"/>

                                                    <!-- Time -->
                                                    <StackPanel Orientation="Horizontal">

                                                        <TextBlock Text="{Binding StartDateTime,
                                                            StringFormat={}{0:h:mm tt}}"
                                                                   FontSize="12"/>

                                                        <TextBlock Text=" - "
                                                                   FontSize="12"/>

                                                        <TextBlock Text="{Binding EndDateTime,
                                                            StringFormat={}{0:h:mm tt}}"
                                                                   FontSize="12"/>

                                                    </StackPanel>

                                                    <!-- Description -->
                                                    <TextBlock Text="{Binding Task.Description}"
                                                               FontSize="11"
                                                               Foreground="#606060"
                                                               TextWrapping="Wrap"
                                                               MaxHeight="35"
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        
        <userControls:TaskEditorView
            Grid.Row="0"
            Grid.RowSpan="2"
            DataContext="{Binding Editor}"
            Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibilityConverter}}"/>
    </Grid>
</UserControl>