<UserControl x:Class="ProductivityManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ProductivityManager.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="675">
    <Grid Background="#F5F5F5">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="CurrentDateText"
                   Grid.Row="0"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#202020"/>

        <UniformGrid Grid.Row="1"
                     Columns="7"
                     Margin="15,0,15,15">
        
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="3">
                <StackPanel>
                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both"
                             MaxHeight="30"
                             Margin="8,10">

                        <TextBlock Text="Sunday"
                                   Width="110"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="3">
                <StackPanel>
                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both"
                             MaxHeight="30"
                             Margin="8,10">

                        <TextBlock Text="Monday"
                                   Width="110"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="3">
                <StackPanel>
                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both"
                             MaxHeight="30"
                             Margin="8,10">

                        <TextBlock Text="Tuesday"
                                   Width="110"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="3">
                <StackPanel>
                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both"
                             MaxHeight="30"
                             Margin="8,10">

                        <TextBlock Text="Wednesday"
                                   Width="110"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="3">
                <StackPanel>
                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both"
                             MaxHeight="30"
                             Margin="8,10">

                        <TextBlock Text="Thursday"
                                   Width="110"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="3">
                <StackPanel>
                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both"
                             MaxHeight="30"
                             Margin="8,10">

                        <TextBlock Text="Friday"
                                   Width="110"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        
            <Border Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="3">
                <StackPanel>
                    <Viewbox Stretch="Uniform"
                             StretchDirection="Both"
                             MaxHeight="30"
                             Margin="8,10">

                        <TextBlock Text="Saturday"
                                   Width="110"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   TextAlignment="Center"/>
                    </Viewbox>
                </StackPanel>
            </Border>
        </UniformGrid>
    </Grid>
</UserControl>
