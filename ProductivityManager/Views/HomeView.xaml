<UserControl x:Class="ProductivityManager.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:userControls="clr-namespace:ProductivityManager.Views.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="1920"
             d:DesignWidth="1080">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="{StaticResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Button Content="+ Add Task" Command="{Binding AddTaskCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Margin="20,0,0,0"
                        Padding="16,8"/>
                <TextBlock Text="{Binding CurrentDateText}" HorizontalAlignment="Center"
                           VerticalAlignment="Center" FontSize="24" FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"/>
                <Border Background="{StaticResource PrimarySoftBrush}"
                        CornerRadius="12"
                        Padding="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,20,0">
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Weekly"
                                Command="{Binding ShowWeeklyCommand}"
                                Padding="12,6"
                                BorderThickness="0"
                                Margin="0,0,2,0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="9"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Opacity"
                                                                Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsWeeklyView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="Monthly"
                                Command="{Binding ShowMonthlyCommand}"
                                Padding="12,6"
                                BorderThickness="0">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="ButtonBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="9"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="ButtonBorder"
                                                                Property="Opacity"
                                                                Value="0.8"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsMonthlyView}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- WEEKLY CALENDAR -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" Visibility="{Binding IsWeeklyView,
                      Converter={StaticResource BoolToVisibilityConverter}}"
                      Margin="15,0,15,15">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- One Day -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="3"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Day Name / Date -->
                            <Border Grid.Row="0"
                                    Grid.RowSpan="2"
                                    CornerRadius="6"
                                    Padding="4"
                                    Margin="0,0,0,8">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background" Value="#E8EBF0"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <StackPanel>
                                    <!-- Day Name -->
                                    <TextBlock Text="{Binding DayName}"
                                               HorizontalAlignment="Center"
                                               FontSize="18"
                                               FontWeight="SemiBold"/>

                                    <!-- Date -->
                                    <TextBlock Text="{Binding DateText}"
                                               HorizontalAlignment="Center"
                                               Foreground="#606060"
                                               Margin="0,2,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- Tasks -->
                            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Occurrences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,3">
                                                <Border BorderThickness="1" CornerRadius="6">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Background" Value="#E5F5EC"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                                    <Setter Property="Opacity" Value="0.75"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Task}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="8"
                                                                HorizontalContentAlignment="Left">
                                                            <StackPanel Margin="0,0,25,0">
                                                                <TextBlock Text="{Binding Task.TaskName}"
                                                                           FontSize="14"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="Wrap">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                                    <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <TextBlock Text="{Binding Task.Category}"
                                                                           FontSize="11"
                                                                           Foreground="#606060"
                                                                           Margin="0,2,0,4"/>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <TextBlock Text="{Binding StartDateTime, StringFormat={}{0:h:mm tt}}"
                                                                               FontSize="12"/>
                                                                    <TextBlock Text=" - "
                                                                               FontSize="12"/>
                                                                    <TextBlock Text="{Binding EndDateTime, StringFormat={}{0:h:mm tt}}"
                                                                               FontSize="12"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Task.Description}"
                                                                           FontSize="11"
                                                                           Foreground="#606060"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,5,0,0"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                                  HorizontalAlignment="Right"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,10,10,0"
                                                                  ToolTip="Mark task complete"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- MONTHLY CALENDAR -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Days}" Visibility="{Binding IsMonthlyView,
                      Converter={StaticResource BoolToVisibilityConverter}}"
                      Margin="15,0,15,15">

            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="7"
                                 Rows="6"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>

            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <!-- One Day -->
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Margin="2"
                            Padding="5">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <!-- Day Number -->
                            <Border Grid.Row="0"
                                    HorizontalAlignment="Right"
                                    CornerRadius="10"
                                    Padding="6,2"
                                    Margin="0,0,3,3">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                <Setter Property="Background" Value="#E2E6EC"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>

                                <TextBlock Text="{Binding DayNumber}"
                                           FontSize="13"
                                           FontWeight="SemiBold"/>
                            </Border>

                            <!-- Tasks -->
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled">
                                <ItemsControl ItemsSource="{Binding Occurrences}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,1">
                                                <Border BorderThickness="1" CornerRadius="4">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Background" Value="{StaticResource PrimarySoftBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                            <Setter Property="Opacity" Value="1"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsCompleted}" Value="True">
                                                                    <Setter Property="Background" Value="#E5F5EC"/>
                                                                    <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                                    <Setter Property="Opacity" Value="0.75"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <Grid>
                                                        <Button Command="{Binding DataContext.OpenTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding Task}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="4"
                                                                HorizontalContentAlignment="Stretch">
                                                            <StackPanel Margin="0,0,18,0">
                                                                <TextBlock Text="{Binding Task.TaskName}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           TextWrapping="NoWrap"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding StartDateTime, StringFormat={}{0:h:mm tt}}"
                                                                           FontSize="9"
                                                                           Foreground="#606060"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <CheckBox IsChecked="{Binding IsCompleted, Mode=TwoWay}"
                                                                  HorizontalAlignment="Right"
                                                                  VerticalAlignment="Top"
                                                                  Margin="0,6,6,0"
                                                                  ToolTip="Mark task complete"/>
                                                    </Grid>
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- TASK EDITOR OVERLAY -->
        <userControls:TaskEditorView
            Grid.Row="0"
            Grid.RowSpan="2"
            DataContext="{Binding Editor}"
            Visibility="{Binding IsOpen,
                Converter={StaticResource BoolToVisibilityConverter}}"/>

    </Grid>
</UserControl>