<UserControl x:Class="ProductivityManager.Views.UserControls.SideBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ProductivityManager.Views.UserControls"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="300">
    <Grid Width="125" Background="LightGray">
        <Grid.RowDefinitions>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>
        <Button Grid.Row="0" Width="100" Height="33" Background="White" Content="Home" FontSize="20"></Button>
        <Button Grid.Row="1" Width="100" Height="33" Background="White" Content="Tasks" FontSize="20"></Button>
        <Button Grid.Row="2" Width="100" Height="33" Background="White" Content="Settings" FontSize="20"></Button>
    </Grid>
</UserControl>
