<UserControl x:Class="ProductivityManager.Views.UserControls.TaskEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="1920" d:DesignHeight="1080">
    
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Background="#800F172A">
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" Width="500"
                Padding="24" CornerRadius="16" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel>
                <StackPanel>
                    <Button Content="Delete Task" Command="{Binding DeleteTaskCommand}"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="{Binding IsEditing, 
                            Converter={StaticResource BoolToVisibilityConverter}}"
                            HorizontalAlignment="Right"
                            Padding="10,6"/>
                </StackPanel>
                <TextBlock Text="{Binding EditorTitle}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           Margin="0,0,0,18"/>

                <TextBlock Text="Task Name"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBox Text="{Binding TaskName, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,10"/>

                <TextBlock Text="Category"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBox Text="{Binding Category, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,10"/>

                <TextBlock Text="Description"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>
                <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                         Height="80"
                         TextWrapping="Wrap"
                         AcceptsReturn="True"
                         Margin="0,4,0,15"/>

                <TextBlock Text="Task Type"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <ComboBox ItemsSource="{Binding TaskTypes}"
                          SelectedItem="{Binding SelectedTaskType}" Margin="0,4,0,15"/>
                
                <TextBlock Text="Start Date"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <DatePicker SelectedDate="{Binding StartDate, Mode=TwoWay}" Margin="0,4,0,10"/>
                
                <StackPanel Visibility="{Binding IsDaily, 
                    Converter={StaticResource BoolToVisibilityConverter}}">
                    <TextBlock Text="End Date"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}" Margin="0,4,0,10"/>
                </StackPanel>
                
                <StackPanel Visibility="{Binding IsWeekly,
              Converter={StaticResource BoolToVisibilityConverter}}">

                    <CheckBox Content="No End Date"
                              IsChecked="{Binding NoEndDate}"
                              Margin="0,5,0,8"/>

                    <TextBlock Text="End Date"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                IsEnabled="{Binding HasEndDate}"
                                Margin="0,4,0,12"/>

                    <TextBlock Text="Repeat On"
                               Foreground="{StaticResource PrimaryBrush}"
                               FontWeight="SemiBold"
                               Margin="0,0,0,6"/>

                    <UniformGrid Columns="4" Margin="0,0,0,12">
                        <CheckBox Content="Sun" IsChecked="{Binding Sunday}"/>

                        <CheckBox Content="Mon" IsChecked="{Binding Monday}"/>

                        <CheckBox Content="Tue" IsChecked="{Binding Tuesday}"/>

                        <CheckBox Content="Wed" IsChecked="{Binding Wednesday}"/>

                        <CheckBox Content="Thu" IsChecked="{Binding Thursday}"/>

                        <CheckBox Content="Fri" IsChecked="{Binding Friday}"/>

                        <CheckBox Content="Sat" IsChecked="{Binding Saturday}"/>
                    </UniformGrid>
                </StackPanel>
                
                <StackPanel Visibility="{Binding IsMonthly,
                    Converter={StaticResource BoolToVisibilityConverter}}">
                    <CheckBox Content="No End Date" IsChecked="{Binding NoEndDate}"
                              Margin="0,5,0,8"/>

                    <TextBlock Text="End Date"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <DatePicker SelectedDate="{Binding EndDate, Mode=TwoWay}"
                                IsEnabled="{Binding HasEndDate}" Margin="0,4,0,12"/>

                    <TextBlock Text="Day of Month"
                               Foreground="{StaticResource MutedTextBrush}"
                               FontSize="12"
                               FontWeight="SemiBold"/>

                    <TextBox Text="{Binding DayOfMonth, UpdateSourceTrigger=PropertyChanged}" 
                             Margin="0,4,0,10"/>
                </StackPanel>
                
                <TextBlock Text="Start Time"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <TextBox Text="{Binding StartTime,
                UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,10"/>

                <TextBlock Text="End Time"
                           Foreground="{StaticResource MutedTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"/>

                <TextBox Text="{Binding EndTime,
                UpdateSourceTrigger=PropertyChanged}"
                         Margin="0,4,0,10"/>
                
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource DangerBrush}"
                           Margin="0,8,0,8"
                           TextWrapping="Wrap"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">

                    <Button Content="Cancel"
                            Command="{Binding CancelCommand}"
                            Margin="0,0,8,0"/>

                    <Button Content="{Binding SubmitButtonText}"
                            Command="{Binding CreateTaskCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"/>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>